{
  "info": {
    "_postman_id": "mini-operations-erp-demo",
    "name": "Mini Operations ERP API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@fundsroom.local\", \"password\": \"Admin@123\"}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Current User Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Get All Users List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/users"
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "List Inventory Items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/inventory"
          }
        },
        {
          "name": "List Stock Transaction Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/inventory/logs"
          }
        }
      ]
    },
    {
      "name": "Work Orders",
      "item": [
        {
          "name": "Create Work Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"location\": \"Warehouse-1\", \"item\": \"Item-A\", \"requiredQty\": 120, \"assignedUserId\": 2}"
            },
            "url": "{{baseUrl}}/work-orders"
          }
        },
        {
          "name": "List Work Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/work-orders"
          }
        },
        {
          "name": "Update Work Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"IN_PROGRESS\"}"
            },
            "url": "{{baseUrl}}/work-orders/1/status"
          }
        }
      ]
    },
    {
      "name": "Internal Transfers",
      "item": [
        {
          "name": "Request Internal Stock Transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"sourceLocation\": \"Warehouse-1\", \"destinationLocation\": \"Warehouse-2\", \"item\": \"Item-A\", \"batch\": \"B-001\", \"quantity\": 15}"
            },
            "url": "{{baseUrl}}/transfers"
          }
        },
        {
          "name": "List Internal Transfers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/transfers"
          }
        },
        {
          "name": "Dispatch Transfer (Reduces Source Stock)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/transfers/1/dispatch"
          }
        },
        {
          "name": "Receive Transfer (Increases Destination Stock)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/transfers/1/receive"
          }
        }
      ]
    },
    {
      "name": "Customer Orders",
      "item": [
        {
          "name": "Reserve Stock for Customer Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"customerName\": \"Acmecorp\", \"item\": \"Item-A\", \"location\": \"Warehouse-1\", \"batch\": \"B-001\", \"quantity\": 50}"
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "List Customer Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Ship Customer Order (Deducts reserved stock)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/orders/1/complete"
          }
        },
        {
          "name": "Cancel Customer Order (Releases reserved stock)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/orders/1/cancel"
          }
        }
      ]
    }
  ]
}