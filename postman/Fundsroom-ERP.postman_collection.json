{
  "info": {
    "_postman_id": "fundsroom-erp-demo",
    "name": "Fundsroom ERP API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@fundsroom.local\", \"password\": \"Admin@123\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "List Customers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/customers"
      }
    },
    {
      "name": "Create Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Demo Customer\", \"mobile\": \"9999999999\", \"email\": \"demo@example.com\", \"businessName\": \"Demo Business\", \"type\": \"RETAIL\", \"address\": \"Vadodara\", \"status\": \"LEAD\"}"
        },
        "url": "{{baseUrl}}/customers"
      }
    },
    {
      "name": "List Products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/products"
      }
    },
    {
      "name": "Create Confirmed Challan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"customerId\": 1, \"status\": \"CONFIRMED\", \"items\": [{\"productId\": 1, \"quantity\": 2}]}"
        },
        "url": "{{baseUrl}}/challans"
      }
    },
    {
      "name": "List Challans",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/challans"
      }
    }
  ]
}