generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATIONS_USER
  SALES_USER
}

enum WorkOrderStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum TransferStatus {
  REQUESTED
  DISPATCHED
  RECEIVED
}

enum CustomerOrderStatus {
  RESERVED
  COMPLETED
  CANCELLED
}

model User {
  id           Int                @id @default(autoincrement())
  name         String
  email        String             @unique
  passwordHash String
  role         Role
  createdAt    DateTime           @default(now())
  workOrders   WorkOrder[]        @relation("AssignedUser")
  transfers    InternalTransfer[] @relation("TransferCreatedBy")
  orders       CustomerOrder[]    @relation("OrderCreatedBy")
}

model InventoryItem {
  id           Int      @id @default(autoincrement())
  item         String
  category     String
  location     String
  batch        String
  physicalQty  Int      @default(0)
  reservedQty  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([item, location, batch])
  @@index([item])
  @@index([location])
}

model WorkOrder {
  id             Int             @id @default(autoincrement())
  location       String
  item           String
  requiredQty    Int
  assignedUserId Int
  assignedUser   User            @relation("AssignedUser", fields: [assignedUserId], references: [id])
  status         WorkOrderStatus @default(ASSIGNED)
  shortageQty    Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model InternalTransfer {
  id                  Int            @id @default(autoincrement())
  sourceLocation      String
  destinationLocation String
  item                String
  batch               String
  quantity            Int
  status              TransferStatus @default(REQUESTED)
  createdById         Int
  createdBy           User           @relation("TransferCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model CustomerOrder {
  id           Int                 @id @default(autoincrement())
  customerName String
  item         String
  location     String
  batch        String
  quantity     Int
  status       CustomerOrderStatus @default(RESERVED)
  createdById  Int
  createdBy    User                @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model StockLog {
  id          Int      @id @default(autoincrement())
  item        String
  location    String
  batch       String
  quantity    Int      // change in physical stock (+/-)
  reservedChange Int   // change in reserved stock (+/-)
  type        String   // e.g. "INITIAL", "WORK_ORDER_COMPLETED", "TRANSFER_DISPATCH", "TRANSFER_RECEIPT", "CUSTOMER_RESERVE", "CUSTOMER_RELEASE", "CUSTOMER_COMPLETE"
  referenceId String?  // ID/number of work order, transfer, or customer order
  createdAt   DateTime @default(now())
}
